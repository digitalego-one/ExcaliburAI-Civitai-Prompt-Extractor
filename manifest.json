{
  "manifest_version": 3,
  "name": "ExcaliburAI - Civitai Prompt Extractor",
  "version": "1.7.0",
  "description": "Copies prompt and metadata in clipboard with 1 click from Ai-generated images, if there is any.",
  "permissions": [
    "contextMenus",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://civitai.com/*",
    "https://*.civitai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
