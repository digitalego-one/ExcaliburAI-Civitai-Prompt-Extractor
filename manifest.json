{
  "manifest_version": 3,
  "name": "ExcaliburAI - Civitai Prompt Extractor",
  "version": "1.0",
  "description": "Copies prompt and metadata in clipboard with 1 click from Ai-generated images, if there is any.",
  "permissions": [
    "contextMenus",
    "scripting",
    "clipboardWrite",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["exif.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
